---
import LightBulb from 'icons/LightBulb.astro';
---
<button id="theme-switch" transition:persist>
  <LightBulb class="emoji" />
</button>
<script>
  import { Theme } from '../themes';
  import { buildCookie } from '../cookies';

  const themeSwitch = document.getElementById('theme-switch') as HTMLButtonElement;

  const currentTheme = (): string =>
    document.documentElement.classList.contains(Theme.DARK + '-theme')
      ? Theme.DARK
      : Theme.LIGHT;

  const setTheme = (newTheme: string, shouldSetCookie: boolean = false) => {
    const oldTheme = newTheme === Theme.DARK ? Theme.LIGHT : Theme.DARK;
    document.documentElement.classList.remove(`${oldTheme}-theme`);
    document.documentElement.classList.add(`${newTheme}-theme`);
    // Button should be opposite theme the theme we just switched away from
    themeSwitch.title = `${oldTheme} mode`;

    if (newTheme && shouldSetCookie) {
      document.cookie = buildCookie('theme', newTheme);
    }
  };

  // The blocking inline script in Layout.astro has already set the theme
  // class on <html>; just reflect it in the button's title.
  themeSwitch.title = `${
    currentTheme() === Theme.DARK ? Theme.LIGHT : Theme.DARK
  } mode`;

  themeSwitch.addEventListener('click', () => {
    const newTheme = currentTheme() === Theme.DARK ? Theme.LIGHT : Theme.DARK;
    setTheme(newTheme, true);
  });
</script>
