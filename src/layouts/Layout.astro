---
import { ClientRouter } from 'astro:transitions';

import './main.css';
import Nav from './Nav.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="preload"
      href="/fonts/azuro-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/azuro-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="👋🏻👨🏼‍💻🐍☔️🇨🇦" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const applyTheme = () => {
          const m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
          const theme = m?.[1] ??
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const root = document.documentElement;
          root.classList.remove('light-theme', 'dark-theme');
          root.classList.add(`${theme}-theme`);
        };
        applyTheme();
        // The ClientRouter strips every attribute off <html> on navigation, and
        // it won't re-run this script (identical contents on every page), so
        // re-apply the class here — after-swap runs before the new page paints.
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <div id="cover">
      <Nav />
      <slot />
    </div>
    <script>
      document.fonts.ready.then(function () {
        document.body.classList.add('fonts-loaded');
      });
    </script>
  </body>
</html>
